# --- Byte-compiled / cache files ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Virtual environments ---
venv/
env/
.venv/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Dataset (large CSV files, download separately from Kaggle) ---
data/*.csv
data/*.zip
!data/.gitkeep

# --- Trained models / large binaries ---
saved_model/*.h5
saved_model/*.keras
!saved_model/.gitkeep

# --- Generated outputs ---
outputs/*.png
outputs/*.txt
!outputs/.gitkeep

# --- OS / editor junk ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Logs ---
*.log
